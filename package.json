{
  "name": "system-engineer-simulator-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:infrastructure",
    "dev:infrastructure": "npm run dev --workspace @se-simulator/infrastructure-project-simulator --",
    "dev:development": "npm run dev --workspace @se-simulator/development-project-simulator --",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "preview:infrastructure": "npm run preview --workspace @se-simulator/infrastructure-project-simulator",
    "preview:development": "npm run preview --workspace @se-simulator/development-project-simulator"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
